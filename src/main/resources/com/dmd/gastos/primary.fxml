<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dmd.gastos.PrimaryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox alignment="CENTER" spacing="40.0">
            <children>
                <VBox spacing="10.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label prefWidth="90.0" text="Alimentación" />
                                <TextField fx:id="txtAlimentacion" prefWidth="100.0" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label prefWidth="90.0" text="Refrigerios" />
                                <TextField fx:id="txtRefrigerios" prefWidth="100.0" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label prefWidth="90.0" text="Transporte" />
                                <TextField fx:id="txtTransporte" prefWidth="100.0" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label prefWidth="90.0" text="Telefonía" />
                                <TextField fx:id="txtTelefonia" prefWidth="100.0" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label prefWidth="90.0" text="Otros" />
                                <TextField fx:id="txtOtros" prefWidth="100.0" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <VBox spacing="10.0">
                    <children>
                        <Label text="Estadísticas" />
                        <Label text="Total semanal" />
                        <TextField fx:id="txtTotal" editable="false" prefWidth="120.0" />
                        <Label text="Gasto más alto" />
                        <TextField fx:id="txtGastoAlto" editable="false" prefWidth="120.0" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <Button onAction="#calcularEstadisticas" prefWidth="120.0" text="Calcular estadísticas" />
                <Button onAction="#limpiar" prefWidth="100.0" text="Limpiar" />
            </children>
        </HBox>
    </children>
</VBox>
